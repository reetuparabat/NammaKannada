# ==========================================
# NammaKannada Backend .gitignore
# ==========================================

# Sensitive Environment Configurations & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example

# Python Bytecode & Compilation Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Local SQLite Databases (Contains local state/user data)
*.db
*.sqlite
*.sqlite3
!nammaconnect_bundled.db

# Testing, Coverage & Profiling
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Logs & Temporary Files
*.log
logs/

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System Artifacts
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
