# NammaKannada Backend — Environment Variables Example
# Copy this file to .env and fill in values for your environment.
# NEVER commit the .env file with real credentials.

# Database connection string (SQLite for development)
DATABASE_URL=sqlite:///./nammakannada.db

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

# Secret key for JWT tokens (change this in production!)
SECRET_KEY=change-this-to-a-long-random-string-in-production

# JWT algorithm
ALGORITHM=HS256

# Token expiry in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin credentials (change these in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Debug mode (set to False in production)
DEBUG=False

# App version
APP_VERSION=1.0.0

# Voice Translator Settings
TRANSLATION_PROVIDER=auto
TRANSLATION_TIMEOUT_SECONDS=8

# Optional: Dedicated Google Cloud Translation API Key
# GOOGLE_TRANSLATE_API_KEY=your-google-cloud-api-key

# Optional: Microsoft Azure Translator Key & Region
# AZURE_TRANSLATOR_KEY=your-azure-key
# AZURE_TRANSLATOR_REGION=global

# Optional: MyMemory email (elevates free tier to 10,000 words/day dedicated quota)
MYMEMORY_EMAIL=reetuparabat662@gmail.com
# MYMEMORY_API_KEY=your-mymemory-key

# Optional: LibreTranslate self-hosted endpoint
# LIBRETRANSLATE_URL=https://libretranslate.example.com
# LIBRETRANSLATE_API_KEY=your-key

MAX_AUDIO_UPLOAD_MB=15

