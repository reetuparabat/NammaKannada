# ==========================================
# NammaKannada Frontend .gitignore
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Environment variables & secrets (NEVER COMMIT)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env.*
!.env.example

# Next.js build & export outputs
/.next/
/out/
/build
/dist

# Testing & verification artifacts
/coverage
/test-results/
/playwright-report/
/blob-report/
*_verification.png
*.png.tmp

# Vercel & Deployment
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Debug & npm logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
*.pem
