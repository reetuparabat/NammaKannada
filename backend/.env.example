# NammaConnect Backend — Environment Variables Example
# Copy this file to .env and fill in values for your environment.
# NEVER commit the .env file with real credentials.

# Database connection string (SQLite for development)
DATABASE_URL=sqlite:///./nammaconnect.db

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

# Secret key for JWT tokens (change this in production!)
SECRET_KEY=change-this-to-a-long-random-string-in-production

# JWT algorithm
ALGORITHM=HS256

# Token expiry in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin credentials (change these in production!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Debug mode (set to False in production)
DEBUG=False

# App version
APP_VERSION=1.0.0
